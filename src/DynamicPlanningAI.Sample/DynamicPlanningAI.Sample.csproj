<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsProductionProject>true</IsProductionProject>
    <RootNamespace>DynamicPlanningAI.Sample</RootNamespace>
    <AssemblyName>DynamicPlanningAI.Sample</AssemblyName>
    <Description>Deterministic console simulation demonstrating DynamicPlanningAI.</Description>
    <!-- Sample is referenced by tests; keep public API. Localized resources not required for console host. -->
    <NoWarn>$(NoWarn);CA1515;CA1303;CA1002;CA1031;CA1062</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DynamicPlanningAI.Abstractions\DynamicPlanningAI.Abstractions.csproj" />
    <ProjectReference Include="..\DynamicPlanningAI.Runtime\DynamicPlanningAI.Runtime.csproj" />
    <ProjectReference Include="..\DynamicPlanningAI.Configuration\DynamicPlanningAI.Configuration.csproj" />
    <ProjectReference Include="..\DynamicPlanningAI.Diagnostics\DynamicPlanningAI.Diagnostics.csproj" />
  </ItemGroup>
</Project>
