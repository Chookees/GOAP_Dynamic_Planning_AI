<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsProductionProject>true</IsProductionProject>
    <RootNamespace>DynamicPlanningAI.Audit</RootNamespace>
    <AssemblyName>DynamicPlanningAI.Audit</AssemblyName>
    <Description>Source-tree Power-of-Ten and allocation-path compliance audit tool.</Description>
    <!-- Application entry assembly: public CLI surface; localization resources not required. -->
    <NoWarn>$(NoWarn);CA1515;CA1303</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
</Project>
